    "@repo/product": "workspace:*",
    "@repo/seo": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vinext/cloudflare": "^1.0.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
